{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": ["generated-repository/**"],
  "ignoreBinaries": ["getconf"],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "audit": {
    "gate": "new-only",
    "healthBaseline": "fallow-health-recorded-hits.json"
  },
  "boundaries": {
    "zones": [
      {
        "name": "cli",
        "patterns": ["src/**"]
      },
      {
        "name": "scripts",
        "patterns": ["scripts/**"]
      },
      {
        "name": "tests",
        "patterns": ["tests/**"]
      },
      {
        "name": "lint-config",
        "patterns": ["eslint.config.mjs", "config/**"]
      }
    ],
    "rules": [
      {
        "from": "cli",
        "allow": []
      },
      {
        "from": "scripts",
        "allow": ["cli"]
      },
      {
        "from": "tests",
        "allow": ["cli", "scripts", "lint-config"]
      },
      {
        "from": "lint-config",
        "allow": []
      }
    ],
    "coverage": {
      "requireAllFiles": true
    }
  },
  "rules": {
    "dev-dependencies-in-production": "error",
    "private-type-leaks": "error",
    "re-export-cycle": "error",
    "stale-suppressions": "error",
    "test-only-dependencies": "error",
    "type-only-dependencies": "error",
    "unused-dev-dependencies": "error",
    "unused-optional-dependencies": "error",
    "boundary-violation": "error",
    "require-suppression-reason": "error"
  },
  "supportEntry": ["scripts/check-file-size.ts"],
  "entry": [
    "scripts/doctor.ts",
    "scripts/check-change-notes.ts",
    "scripts/check-commits.ts",
    "scripts/check-names.ts",
    "scripts/kernel-trial-command.ts",
    "scripts/pin-verification.ts",
    "scripts/planted-faults.ts",
    "scripts/template-version.ts",
    "scripts/test-area.ts"
  ]
}
