{
  "$schema": "./node_modules/fallow/schema.json",
  "ignorePatterns": [
    "config/anti-slop-bindings.mjs",
    "config/anti-slop-rules.mjs",
    "config/anti-slop-type-rules.mjs",
    "config/payload-rules.mjs",
    "config/platform-rules.mjs",
    "config/template-rules.mjs",
    "stamp-checker.ts",
    "config/kernel/**",
    "src/kernel/**",
    "src/addons/**"
  ],
  "entry": ["tests/cli.test.ts"],
  "typeAware": {
    "enabled": true,
    "projects": ["tsconfig.json"],
    "require": "complete"
  },
  "audit": {
    "gate": "all",
    "css": false,
    "cssDeep": false
  },
  "rules": {
    "boundary-violation": "off",
    "circular-dependencies": "error",
    "coverage-gaps": "off",
    "css-broken-reference": "off",
    "css-dead-surface": "off",
    "css-duplicate-block": "off",
    "css-selector-complexity": "off",
    "css-token-drift": "off",
    "dev-dependencies-in-production": "error",
    "duplicate-exports": "off",
    "duplicate-prop-shape": "off",
    "dynamic-segment-name-conflict": "off",
    "empty-catalog-groups": "off",
    "feature-flags": "off",
    "invalid-client-export": "off",
    "misconfigured-dependency-overrides": "off",
    "misplaced-directive": "off",
    "mixed-client-server-barrel": "off",
    "policy-violation": "off",
    "private-type-leaks": "off",
    "prop-drilling": "off",
    "re-export-cycle": "error",
    "require-suppression-reason": "error",
    "route-collision": "off",
    "security-client-server-leak": "off",
    "security-sink": "off",
    "stale-suppressions": "error",
    "test-only-dependencies": "error",
    "thin-wrapper": "off",
    "type-only-dependencies": "error",
    "unlisted-dependencies": "error",
    "unprovided-injects": "off",
    "unrendered-components": "off",
    "unresolved-catalog-references": "off",
    "unresolved-imports": "error",
    "unused-catalog-entries": "off",
    "unused-class-members": "off",
    "unused-component-emits": "off",
    "unused-component-inputs": "off",
    "unused-component-outputs": "off",
    "unused-component-props": "off",
    "unused-dependencies": "error",
    "unused-dependency-overrides": "off",
    "unused-dev-dependencies": "off",
    "unused-enum-members": "off",
    "unused-exports": "error",
    "unused-files": "error",
    "unused-load-data-keys": "off",
    "unused-optional-dependencies": "off",
    "unused-server-actions": "off",
    "unused-store-members": "off",
    "unused-svelte-events": "off",
    "unused-types": "error",
    "deprecated-exports-in-use": "off",
    "unused-namespace-members": "off",
    "absent-component-props": "off",
    "constant-parameters": "off",
    "unused-effect-layers": "off",
    "unused-tagged-errors": "off",
    "unproduced-catch-tags": "off",
    "complexity-cyclomatic": "off",
    "complexity-cognitive": "off",
    "complexity-crap": "off",
    "complexity-file-lines": "off",
    "unlisted-binaries": "off",
    "duplicate-export-aliases": "off",
    "package-cycle": "off",
    "weakened-tests": "off",
    "added-suppression": "off",
    "test-only-branch": "off",
    "diverged-clone-sibling": "off",
    "added-dependency": "off"
  }
}
