{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/.fallow",
      "!**/bun.lock",
      "!.kernel-stamp.json",
      "!stamp-checker.ts",
      "!config/kernel",
      "!src/kernel",
      "!src/addons"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
