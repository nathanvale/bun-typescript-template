{
  "name": "__REPOSITORY_NAME__",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "description": "Static-admission complex profile policy source.",
  "scripts": {
    "start": "bun run src/cli.ts",
    "biome:check": "bun run format:check",
    "check:config": "tsc --showConfig -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "quality:fallow": "node_modules/.bin/fallow dead-code --format json --quiet --type-aware --type-aware-require complete --fail-on-issues",
    "quality:fallow:changed": "node_modules/.bin/fallow audit --format json --quiet --gate all --type-aware --type-aware-require complete",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run --silent quality:fallow && bun run --silent quality:fallow:dependencies",
    "quality:fallow:dependencies": "node_modules/.bin/fallow dead-code --production --format json --quiet --type-aware --type-aware-require complete --fail-on-issues",
    "lint": "eslint . --max-warnings 0",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "check:write": "bun run format"
  },
  "dependencies": {
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "fallow": "3.43.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "fallow-type-aware": "3.43.2"
  },
  "overrides": {
    "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2"
  }
}
