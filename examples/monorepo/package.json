{
	"name": "durable-profile-monorepo-example",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Optional multi-package layout for the durable profile. Self-contained; not required for single-package use.",
	"packageManager": "bun@1.4.0",
	"workspaces": ["packages/*"],
	"catalog": {
		"@types/bun": "1.4.0",
		"typescript": "7.0.2"
	},
	"scripts": {
		"biome:check": "biome check --diagnostic-level=error .",
		"check:write": "biome check --write .",
		"lint": "biome lint --diagnostic-level=error .",
		"lint:fix": "biome lint --write .",
		"typecheck": "bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"quality:fallow": "fallow audit --format json --quiet --type-aware --type-aware-require best-effort",
		"check": "bun run biome:check && bun run typecheck && bun run test && bun run --silent quality:fallow"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/bun": "catalog:",
		"fallow": "3.19.0",
		"typescript": "catalog:"
	}
}
