{
  "name": "__REPOSITORY_NAME__",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Optional multi-package layout for the durable profile. Self-contained; not required for single-package use.",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "catalog": {
    "@types/bun": "1.4.4",
    "typescript": "npm:typescript@7.0.2"
  },
  "scripts": {
    "biome:check": "bun run format:check",
    "check:write": "bun run format",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter '*' typecheck",
    "test": "bun test ./tests && bun run --filter '*' test",
    "quality:fallow": "node_modules/.bin/fallow audit --format json --quiet --type-aware --type-aware-require complete --gate all",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run --silent quality:fallow",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "start": "bun run src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "catalog:",
    "fallow": "3.43.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "fallow-type-aware": "3.43.2"
  },
  "overrides": {
    "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2"
  }
}
