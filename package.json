{
  "name": "bun-typescript-template",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "biome:check": "bun run format:check",
    "bootstrap": "bun run src/bootstrap.ts",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run --silent quality:fallow",
    "check:write": "bun run format",
    "quality:fallow": "node_modules/.bin/fallow audit --format json --quiet --type-aware --type-aware-require best-effort",
    "doctor": "bun run scripts/doctor.ts",
    "pretest": "bun run doctor",
    "test": "bun test --parallel=2 --path-ignore-patterns 'starters/**'",
    "test:area": "bun run scripts/test-area.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "admit:static": "bun run src/static-admission.ts",
    "lint": "eslint . --max-warnings 0",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "admit:cli": "bun run src/cli-inventory.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.0",
    "fallow": "3.43.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.2",
    "fallow-type-aware": "3.43.0"
  },
  "overrides": {
    "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2"
  },
  "dependencies": {
    "@logtape/logtape": "2.4.2",
    "@logtape/redaction": "2.4.2"
  }
}
