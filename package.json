{
  "name": "bun-typescript-template",
  "version": "0.2.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "bootstrap": "bun run src/bootstrap.ts",
    "check": "bun run check:file-size && bun run lint && bun run format:check && bun run typecheck && bun run test && bun run --silent quality:fallow",
    "quality:fallow": "node_modules/.bin/fallow audit --baseline-mode identity --format json --quiet",
    "doctor": "bun run scripts/doctor.ts",
    "check:commits": "bun run scripts/check-commits.ts",
    "check:file-size": "bun --no-install scripts/check-file-size.ts",
    "check:names": "bun run scripts/check-names.ts",
    "fault-replay": "bun run scripts/planted-faults.ts replay",
    "kernel-trial": "bun run scripts/kernel-trial-command.ts",
    "planted-fault:add": "bun run scripts/planted-faults.ts add",
    "pin-move": "bun run scripts/pin-move.ts",
    "pin-verification": "bun run scripts/pin-verification.ts",
    "pretest": "bun run doctor",
    "test": "bun test --parallel=2 --path-ignore-patterns 'generated-repository/**'",
    "test:area": "bun run scripts/test-area.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "prepare": "git config core.hooksPath .githooks || true",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "admit:cli": "bun run src/cli-inventory.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/bun": "1.4.4",
    "tiktoken": "1.0.22",
    "fallow": "3.43.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "eslint": "10.15.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.73.0",
    "fallow-type-aware": "3.43.2"
  },
  "overrides": {
    "@typescript/old@npm:typescript@^6": "npm:typescript@6.0.2"
  }
}
